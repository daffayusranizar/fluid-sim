// GPU-side SPH pipeline.
//
// T-026 built the plumbing, T-027/T-028 the physics, T-029 the GPU-resident
// loop, T-030 the cell keys. T-031 turns those keys into a queryable structure
// (count sort + prefix scan) and rewires the three O(N^2) kernels to walk their
// 3x3 cell neighbourhood instead.
//
// Particle indexing is PACKED, exactly as the CPU grid does it:
//
//   [0, _ParticleCount)              fluid particles, in _ParticlesIn
//   [_ParticleCount, _TotalCount)    boundary particles, in _BoundaryPositions
//
// Boundary particles share the structure rather than getting their own. Leaving
// them out would keep the force kernel's wall loop at O(N*B), and since
// B ~ perimeter/spacing ~ sqrt(N) that term is O(N^1.5) -- only ~3% of the old
// O(N^2) cost at N=10k, but the dominant term once the fluid query is fixed.
// They are static, so their cell membership never changes in principle; at these
// sizes re-sorting them each step is cheaper than the bookkeeping to avoid it.

#pragma kernel ProbeRoundTrip
#pragma kernel ComputeDensity
#pragma kernel ComputePressure
#pragma kernel ComputePressureForce
#pragma kernel ComputeViscosity
#pragma kernel Integrate
#pragma kernel ClearExtremes
#pragma kernel ReduceExtremes
#pragma kernel ComputeCellKeys
#pragma kernel ClearBuckets
#pragma kernel CountBuckets
#pragma kernel PrefixSumBuckets
#pragma kernel ScatterParticles

#define SCAN_THREADS 256

struct Particle
{
    float2 position;     // offset  0
    float2 velocity;     // offset  8
    float2 force;        // offset 16
    float density;       // offset 24
    float pressure;      // offset 28
    float nearDensity;   // offset 32
    float nearPressure;  // offset 36
};                       // 40 bytes

StructuredBuffer<Particle> _ParticlesIn;
RWStructuredBuffer<Particle> _ParticlesOut;

// Boundary particles are static: uploaded once, never written, never integrated.
StructuredBuffer<float2> _BoundaryPositions;

// Density, pressure and force live outside the Particle struct so no pass writes
// a field another thread reads. See the note in T-027/T-028.
RWStructuredBuffer<float> _Density;
RWStructuredBuffer<float> _NearDensity;
RWStructuredBuffer<float> _Pressure;
RWStructuredBuffer<float> _NearPressure;
RWStructuredBuffer<float2> _Force;
RWStructuredBuffer<float2> _ViscosityForce;

// The one value the CPU still needs: max||v|| and max||a||, for the CFL step.
RWStructuredBuffer<uint> _Extremes;

// --- Spatial structure (T-030/T-031) ---

// One entry per PACKED particle.
RWStructuredBuffer<uint> _CellKeys;
RWStructuredBuffer<int2> _CellCoords;

// Sorted particle indices, grouped by bucket. Bucket b owns
// _SortedIndices[_BucketStart[b] .. _BucketStart[b+1]].
RWStructuredBuffer<uint> _BucketStart;   // _BucketCount + 1 entries
RWStructuredBuffer<uint> _SortedIndices;

// Copy of _BucketStart consumed by the scatter. A separate buffer because
// _BucketStart must stay intact for the neighbour queries.
RWStructuredBuffer<uint> _BucketCursor;

uint _ParticleCount;     // fluid only
uint _BoundaryCount;
uint _TotalCount;        // fluid + effective boundary
uint _BucketCount;

// 0 = direct cell index, 1 = prime-multiplier hash. See KeyForCell.
uint _KeyMode;
uint _GridCols;
uint _GridRows;
uint _HashTableSize;

// Cell size is exactly h, and the origin is the container plus h of margin, so
// cell coordinates are always inside [0, cols) x [0, rows) for this box.
float _CellSize;
float2 _GridOrigin;

// --- Solver parameters, mirroring SolverParams on the CPU ---
float _SmoothingLength;
float _SmoothingLengthSq;
float _SpikyPow2Const;
float _SpikyPow3Const;
float _SpikyPow2GradConst;
float _SpikyPow3GradConst;
float _Poly6Const;
float _RestDensity;
float _ParticleMass;
float _BoundaryVolume;
float _NearPressureMultiplier;
float _Stiffness;
float _Viscosity;
uint _ClampPressurePositive;
uint _UseBoundaryParticles;

float2 _Gravity;
float2 _BoxCenter;
float2 _BoxHalfSize;
float _CollisionDamping;
float _DeltaTime;

float2 _ProbeOffset;

// --- Interactive pointer (T-038) ---
// A solid disc the fluid cannot enter, published once per frame by
// SPHInteractor2D and uploaded with the rest of the parameter block, so a pointer
// costs no buffer and no extra dispatch.
float2 _PointerPosition;
float2 _PointerVelocity;
float _PointerRadius;
float _PointerRestitution;
float _PointerFriction;
uint _PointerActive;

// ----------------------------------------------------------------------
// Kernels and equation of state. Direct transcriptions of SPHMath.cs.
// ----------------------------------------------------------------------

float SpikyPow2Kernel(float r, float h, float k)
{
    if (r >= h) return 0.0;
    float hr = h - r;
    return k * hr * hr;
}

float SpikyPow3Kernel(float r, float h, float k)
{
    if (r >= h) return 0.0;
    float hr = h - r;
    return k * hr * hr * hr;
}

// NOTE: unlike the value kernels above, the gradient functions have no r >= h
// early-out -- matching SPHMath.cs, where SpikyPow2GradientMagnitude returns a
// negative (h - r) beyond h. On the CPU that never matters, because the caller
// reaches these through the neighbour grid. Here the caller also arrives through
// the grid, but the grid only guarantees r < 3h, so each call site still keeps an
// explicit r < h test.
float SpikyPow2GradientMagnitude(float r, float h, float k)
{
    return k * (h - r);
}

float SpikyPow3GradientMagnitude(float r, float h, float k)
{
    float hr = h - r;
    return k * hr * hr;
}

/// XSPH viscosity weight. Non-negative everywhere, so a weighted average toward
/// neighbours' velocities cannot add energy.
float Poly6Kernel(float r2, float h2, float k)
{
    if (r2 >= h2) return 0.0;
    float diff = h2 - r2;
    return k * diff * diff * diff;
}

/// Tait equation of state, linear form. The clamp is a flag, not a constant:
/// with the near channel active it must stay off.
float TaitPressure(float density, bool clampPositive)
{
    float p = _Stiffness * (density - _RestDensity);
    if (clampPositive && p < 0.0) p = 0.0;
    return p;
}

float NearPressure(float nearDensity)
{
    return _NearPressureMultiplier * nearDensity;
}

// ----------------------------------------------------------------------
// Spatial keys (T-030)
// ----------------------------------------------------------------------

int2 CellCoordOf(float2 position)
{
    return (int2)floor((position - _GridOrigin) / _CellSize);
}

/// Maps a cell to a bucket. Direct mode is collision-free and only valid for a
/// bounded domain; hash mode is the portable form for an unbounded one.
uint KeyForCell(int2 cell)
{
    if (_KeyMode == 1u)
    {
        uint x = (uint)cell.x * 73856093u;
        uint y = (uint)cell.y * 19349663u;
        return (x ^ y) % _HashTableSize;
    }

    int cx = clamp(cell.x, 0, (int)_GridCols - 1);
    int cy = clamp(cell.y, 0, (int)_GridRows - 1);
    return (uint)(cy * (int)_GridCols + cx);
}

float2 PositionOfPacked(uint p)
{
    if (p < _ParticleCount) return _ParticlesIn[p].position;
    return _BoundaryPositions[p - _ParticleCount];
}

[numthreads(64, 1, 1)]
void ComputeCellKeys(uint3 id : SV_DispatchThreadID)
{
    uint p = id.x;
    if (p >= _TotalCount) return;

    int2 cell = CellCoordOf(PositionOfPacked(p));

    _CellCoords[p] = cell;
    _CellKeys[p] = KeyForCell(cell);
}

// ----------------------------------------------------------------------
// Count sort + prefix scan (T-031)
// ----------------------------------------------------------------------

[numthreads(64, 1, 1)]
void ClearBuckets(uint3 id : SV_DispatchThreadID)
{
    uint b = id.x;
    if (b < _BucketCount) _BucketStart[b] = 0u;
}

/// Pass 1 of the sort: histogram. Atomics are unavoidable here because an
/// arbitrary number of particles share a bucket and the scatter order does not
/// matter.
[numthreads(64, 1, 1)]
void CountBuckets(uint3 id : SV_DispatchThreadID)
{
    uint p = id.x;
    if (p >= _TotalCount) return;

    InterlockedAdd(_BucketStart[_CellKeys[p]], 1u);
}

groupshared uint _scanTile[SCAN_THREADS];

/// Pass 2: exclusive prefix sum over bucket counts, turning them into run
/// offsets. In place: on entry _BucketStart holds counts, on exit it holds the
/// first slot of each bucket's run and _BucketStart[_BucketCount] holds the
/// total.
///
/// One workgroup walks the array in tiles, carrying the running total between
/// them, and scans each tile with a Hillis-Steele inclusive scan. A single
/// workgroup is enough because _BucketCount is ~N/4.8 (~2.3k at N=10k); a
/// multi-workgroup scan would only pay off at an order of magnitude more
/// buckets. Tiles are processed in order, so no inter-workgroup coordination is
/// needed.
[numthreads(SCAN_THREADS, 1, 1)]
void PrefixSumBuckets(uint3 id : SV_DispatchThreadID)
{
    uint t = id.x;
    uint carry = 0u;

    for (uint base = 0u; base < _BucketCount; base += SCAN_THREADS)
    {
        uint i = base + t;
        uint v = (i < _BucketCount) ? _BucketStart[i] : 0u;

        _scanTile[t] = v;
        GroupMemoryBarrierWithGroupSync();

        for (uint offset = 1u; offset < SCAN_THREADS; offset <<= 1)
        {
            uint other = (t >= offset) ? _scanTile[t - offset] : 0u;

            GroupMemoryBarrierWithGroupSync();
            _scanTile[t] += other;
            GroupMemoryBarrierWithGroupSync();
        }

        uint exclusive = carry + _scanTile[t] - v;

        if (i < _BucketCount)
        {
            _BucketStart[i] = exclusive;
            _BucketCursor[i] = exclusive;
        }

        carry += _scanTile[SCAN_THREADS - 1];
        GroupMemoryBarrierWithGroupSync();
    }

    if (t == 0u) _BucketStart[_BucketCount] = carry;
}

/// Pass 3: scatter. Each particle takes the next slot in its bucket via the
/// cursor. Within a bucket the order is therefore arbitrary, which changes the
/// summation order in the density and force kernels but not their meaning.
[numthreads(64, 1, 1)]
void ScatterParticles(uint3 id : SV_DispatchThreadID)
{
    uint p = id.x;
    if (p >= _TotalCount) return;

    // The two-argument InterlockedAdd returns void; the returning form is the
    // three-argument overload with an out parameter.
    uint slot;
    InterlockedAdd(_BucketCursor[_CellKeys[p]], 1u, slot);
    _SortedIndices[slot] = p;
}

// ----------------------------------------------------------------------
// Probe (T-026)
// ----------------------------------------------------------------------

[numthreads(64, 1, 1)]
void ProbeRoundTrip(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    Particle p = _ParticlesIn[i];
    p.position += _ProbeOffset;
    p.force = _BoundaryPositions[0];
    p.density = _BoundaryVolume;

    _ParticlesOut[i] = p;
}

// ----------------------------------------------------------------------
// Density (T-027, gridded in T-031)
// ----------------------------------------------------------------------

[numthreads(64, 1, 1)]
void ComputeDensity(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    float2 posI = _ParticlesIn[i].position;
    int2 cell = CellCoordOf(posI);

    float mainDensity = 0.0;
    float near = 0.0;

    for (int dy = -1; dy <= 1; dy++)
    {
        int cy = cell.y + dy;
        if (cy < 0 || cy >= (int)_GridRows) continue;

        for (int dx = -1; dx <= 1; dx++)
        {
            int cx = cell.x + dx;

            // Out-of-grid cells are SKIPPED, never clamped. Clamping would make
            // KeyForCell return the edge cell for several deltas, so an edge
            // particle would scan the same bucket up to four times and
            // double-count its occupants. The CPU grid skips for the same reason.
            if (cx < 0 || cx >= (int)_GridCols) continue;

            uint key = KeyForCell(int2(cx, cy));
            uint start = _BucketStart[key];
            uint end = _BucketStart[key + 1];

            for (uint s = start; s < end; s++)
            {
                uint q = _SortedIndices[s];

                if (q < _ParticleCount)
                {
                    if (q == i) continue;

                    float r = distance(_ParticlesIn[q].position, posI);
                    mainDensity += _ParticleMass * SpikyPow2Kernel(r, _SmoothingLength, _SpikyPow2Const);
                    near += _ParticleMass * SpikyPow3Kernel(r, _SmoothingLength, _SpikyPow3Const);
                }
                else if (_UseBoundaryParticles != 0u)
                {
                    float r = distance(_BoundaryPositions[q - _ParticleCount], posI);
                    mainDensity += _RestDensity * _BoundaryVolume
                                   * SpikyPow2Kernel(r, _SmoothingLength, _SpikyPow2Const);
                }
            }
        }
    }

    _Density[i] = mainDensity;
    _NearDensity[i] = near;
}

// ----------------------------------------------------------------------
// Pressure (T-027)
// ----------------------------------------------------------------------

[numthreads(64, 1, 1)]
void ComputePressure(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    _Pressure[i] = TaitPressure(_Density[i], _ClampPressurePositive != 0);
    _NearPressure[i] = NearPressure(_NearDensity[i]);
}

// ----------------------------------------------------------------------
// Pressure force (T-028, gridded in T-031)
// ----------------------------------------------------------------------

[numthreads(64, 1, 1)]
void ComputePressureForce(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    float h = _SmoothingLength;
    float h2 = h * h;
    float2 posI = _ParticlesIn[i].position;
    int2 cell = CellCoordOf(posI);
    float2 accumulated = 0.0;

    // The wall may push but never pull, and the clamp here is independent of
    // _ClampPressurePositive: mirroring copies this particle's own pressure,
    // which is often negative at a wall.
    float boundaryPressure = max(0.0, _Pressure[i]);

    for (int dy = -1; dy <= 1; dy++)
    {
        int cy = cell.y + dy;
        if (cy < 0 || cy >= (int)_GridRows) continue;

        for (int dx = -1; dx <= 1; dx++)
        {
            int cx = cell.x + dx;
            if (cx < 0 || cx >= (int)_GridCols) continue;

            uint key = KeyForCell(int2(cx, cy));
            uint start = _BucketStart[key];
            uint end = _BucketStart[key + 1];

            for (uint s = start; s < end; s++)
            {
                uint q = _SortedIndices[s];

                if (q == i) continue;

                float2 rVec = posI - PositionOfPacked(q);
                float r2 = dot(rVec, rVec);

                // The 3x3 scan only guarantees r < 3h, and the gradient functions
                // are unguarded past h, so this test is required at every call site.
                if (r2 >= h2 || r2 <= 0.0) continue;

                float r = sqrt(r2);
                float2 dir = rVec / r;

                if (q < _ParticleCount)
                {
                    float otherDensity = _Density[q];
                    if (otherDensity > 0.0001)
                    {
                        float sharedPressure = (_Pressure[i] + _Pressure[q]) * 0.5;

                        accumulated += dir * (_ParticleMass
                                              * SpikyPow2GradientMagnitude(r, h, _SpikyPow2GradConst)
                                              * sharedPressure / otherDensity);
                    }

                    float otherNearDensity = _NearDensity[q];
                    if (otherNearDensity > 0.0001)
                    {
                        float sharedNearPressure = (_NearPressure[i] + _NearPressure[q]) * 0.5;

                        accumulated += dir * (_ParticleMass
                                              * SpikyPow3GradientMagnitude(r, h, _SpikyPow3GradConst)
                                              * sharedNearPressure / otherNearDensity);
                    }
                }
                else if (_UseBoundaryParticles != 0u)
                {
                    accumulated += dir * (_BoundaryVolume * boundaryPressure
                                          * SpikyPow2GradientMagnitude(r, h, _SpikyPow2GradConst));
                }
            }
        }
    }

    _Force[i] = accumulated;
}

// ----------------------------------------------------------------------
// Viscosity (T-028, gridded in T-031)
// ----------------------------------------------------------------------

[numthreads(64, 1, 1)]
void ComputeViscosity(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    float2 posI = _ParticlesIn[i].position;
    float2 velI = _ParticlesIn[i].velocity;
    int2 cell = CellCoordOf(posI);
    float2 viscForce = 0.0;

    for (int dy = -1; dy <= 1; dy++)
    {
        int cy = cell.y + dy;
        if (cy < 0 || cy >= (int)_GridRows) continue;

        for (int dx = -1; dx <= 1; dx++)
        {
            int cx = cell.x + dx;
            if (cx < 0 || cx >= (int)_GridCols) continue;

            uint key = KeyForCell(int2(cx, cy));
            uint start = _BucketStart[key];
            uint end = _BucketStart[key + 1];

            for (uint s = start; s < end; s++)
            {
                uint q = _SortedIndices[s];

                // Fluid only. Boundary particles are static, so their velocity is
                // zero and including them would just damp the fluid against walls.
                if (q >= _ParticleCount) continue;
                if (q == i) continue;

                float2 rVec = _ParticlesIn[q].position - posI;
                float r2 = dot(rVec, rVec);

                viscForce += (_ParticlesIn[q].velocity - velI)
                             * Poly6Kernel(r2, _SmoothingLengthSq, _Poly6Const);
            }
        }
    }

    _ViscosityForce[i] = viscForce;
    _Force[i] += viscForce * _Viscosity;
}

// ----------------------------------------------------------------------
// Integration (T-028)
// ----------------------------------------------------------------------

/// Resolves one particle against the interactive pointer disc.
///
/// Twin of SPHMath.ResolvePointerCollision on the CPU. The two must stay in step:
/// the only reason both solvers exist is that they can be compared, and a disc
/// that behaves differently on each path makes that comparison worthless.
///
/// A position constraint, not a force. See the CPU version for why that matters
/// to the time step.
void ApplyPointer(inout float2 position, inout float2 velocity)
{
    if (_PointerActive == 0u) return;

    float radius = max(1e-4, _PointerRadius);
    float2 toParticle = position - _PointerPosition;
    float distanceSq = dot(toParticle, toParticle);

    if (distanceSq >= radius * radius) return;

    float distance = sqrt(distanceSq);

    // Exactly on the centre there is no direction to push along. Any direction is
    // better than a NaN, which would spread into the density and force of every
    // particle touching it.
    float2 normal = distance > 1e-6 ? toParticle / distance : float2(0.0, 1.0);

    position = _PointerPosition + normal * radius;

    float2 relative = velocity - _PointerVelocity;
    float inbound = dot(relative, normal);

    if (inbound < 0.0)
    {
        relative -= (1.0 + _PointerRestitution) * inbound * normal;
    }

    // Tangential drag, relative to the disc: the difference between poking the
    // fluid and scooping it.
    float2 normalPart = dot(relative, normal) * normal;
    float2 tangentPart = relative - normalPart;

    velocity = _PointerVelocity + normalPart
               + tangentPart * (1.0 - saturate(_PointerFriction));
}

[numthreads(64, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    float particleDensity = _Density[i];

    if (particleDensity <= 0.0001)
    {
        // No force to integrate, but the pointer is a position constraint rather
        // than a force, so it still applies. Skipping it here would leave a stray
        // particle sitting inside a disc that every other particle respects.
        // Locals rather than passing the struct members straight through: `inout`
        // arguments have to be plain lvalues on some compilers, and this way the
        // shape of the code matches the CPU job exactly.
        Particle isolated = _ParticlesIn[i];
        float2 isolatedPosition = isolated.position;
        float2 isolatedVelocity = isolated.velocity;

        ApplyPointer(isolatedPosition, isolatedVelocity);

        isolated.position = isolatedPosition;
        isolated.velocity = isolatedVelocity;
        _ParticlesOut[i] = isolated;
        return;
    }

    Particle p = _ParticlesIn[i];

    float2 acceleration = _Force[i] / particleDensity + _Gravity;
    float2 v = p.velocity + acceleration * _DeltaTime;
    float2 pos = p.position + v * _DeltaTime;

    float relX = pos.x - _BoxCenter.x;
    float relY = pos.y - _BoxCenter.y;

    if (relX > _BoxHalfSize.x)
    {
        pos.x = _BoxCenter.x + _BoxHalfSize.x;
        v.x *= -_CollisionDamping;
    }
    else if (relX < -_BoxHalfSize.x)
    {
        pos.x = _BoxCenter.x - _BoxHalfSize.x;
        v.x *= -_CollisionDamping;
    }

    if (relY > _BoxHalfSize.y)
    {
        pos.y = _BoxCenter.y + _BoxHalfSize.y;
        v.y *= -_CollisionDamping;
    }
    else if (relY < -_BoxHalfSize.y)
    {
        pos.y = _BoxCenter.y - _BoxHalfSize.y;
        v.y *= -_CollisionDamping;
    }

    // Applied after the wall clamp, so the disc wins where the two disagree. The
    // disc is kept a full radius clear of the walls on the CPU side (see
    // SPHInteractor2D), so in practice they never both act on one particle.
    ApplyPointer(pos, v);

    p.velocity = v;
    p.position = pos;

    _ParticlesOut[i] = p;
}

// ----------------------------------------------------------------------
// Extremes reduction (T-029)
// ----------------------------------------------------------------------

[numthreads(1, 1, 1)]
void ClearExtremes(uint3 id : SV_DispatchThreadID)
{
    _Extremes[0] = 0;
    _Extremes[1] = 0;
}

/// Integer InterlockedMax on the float bit patterns. Valid only because both
/// quantities are magnitudes, where the IEEE bit pattern is monotonic as an
/// unsigned int. It would not work for a signed quantity.
[numthreads(64, 1, 1)]
void ReduceExtremes(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    float speed = length(_ParticlesIn[i].velocity);
    InterlockedMax(_Extremes[0], asuint(speed));

    float d = _Density[i];
    if (d > 0.0001)
    {
        float2 a = _Force[i] / d + _Gravity;
        InterlockedMax(_Extremes[1], asuint(length(a)));
    }
}
